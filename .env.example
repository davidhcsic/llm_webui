# OpenAI-compatible API Gateway (e.g. self-hosted LLM gateway)
OPENAI_API_BASE_URL=https://llm.example.org/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE_URLS=https://llm.example.org/v1
OPENAI_API_KEYS=your_api_key_here
DEFAULT_MODELS=qwen2.5:32b

# WebUI Internal Security
WEBUI_SECRET_KEY=generate_a_random_secret_string

# Default Model Selection
OPENAI_API_MODEL=qwen2.5:32b
ENABLE_OLLAMA_API=false

# Initial Admin User Credentials
WEBUI_ADMIN_EMAIL=admin@localhost
WEBUI_ADMIN_PASSWORD=change_this_password
WEBUI_ADMIN_NAME=Admin
